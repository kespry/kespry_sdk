{
    "swagger": "2.0",
    "basePath": "/api/known-surfaces",
    "paths": {
        "/v1/sites/{site_id}/known-surfaces": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/KnownSurface"
                            }
                        }
                    }
                },
                "description": "Returns all active known surfaces for the specified site.",
                "operationId": "get_known_surface_list",
                "tags": [
                    "known-surfaces"
                ]
            }
        },
        "/v1/sites/{site_id}/known-surfaces/{known_surface_id}": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the known surface",
                    "name": "known_surface_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "404": {
                        "description": "Known surface not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/KnownSurface"
                        }
                    }
                },
                "description": "Returns a single known surface by ID. The known surface must be active on the specified site.",
                "operationId": "get_known_surface_detail",
                "tags": [
                    "known-surfaces"
                ]
            }
        }
    },
    "info": {
        "title": "Firmatek Known Surfaces API",
        "version": "1.0",
        "description": "Known Surfaces API for accessing Known Surfaces in the Kespry Platform",
        "termsOfService": "https://firmatek.com/terms-of-use/"
    },
    "produces": [
        "application/json"
    ],
    "consumes": [
        "application/json"
    ],
    "securityDefinitions": {
        "apikey": {
            "type": "apiKey",
            "in": "header",
            "name": "Authorization"
        }
    },
    "security": [
        {
            "apikey": [
                {
                    "type": "apiKey",
                    "in": "header",
                    "name": "Authorization"
                }
            ]
        }
    ],
    "tags": [
        {
            "name": "known-surfaces",
            "description": "APIs for accessing Known Surfaces defined for a Site. Known surfaces are reusable base surfaces referenced by volume markers via known_surface_id."
        }
    ],
    "definitions": {
        "KnownSurface": {
            "required": [
                "id",
                "surface_name"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Known surface ID",
                    "example": 42
                },
                "surface_name": {
                    "type": "string",
                    "description": "Name of the known surface",
                    "example": "Base Grade"
                },
                "surface_description": {
                    "type": "string",
                    "description": "Description of the known surface",
                    "example": "Pre-construction base grade survey"
                },
                "review_status": {
                    "type": "string",
                    "description": "Review status of the surface model",
                    "example": "approved"
                },
                "surface_image_file_name": {
                    "type": "string",
                    "description": "File name of the surface image attachment",
                    "example": "base_grade.png"
                },
                "surface_image_content_type": {
                    "type": "string",
                    "description": "MIME type of the surface image attachment",
                    "example": "image/png"
                },
                "created_at": {
                    "type": "string",
                    "description": "Date the known surface was created (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-10 09:00:00"
                },
                "updated_at": {
                    "type": "string",
                    "description": "Date the known surface was last updated (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-03-05 14:22:11"
                }
            },
            "type": "object"
        },
        "Error": {
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string",
                    "description": "Human-readable error message",
                    "example": "Not authorized to access this site (4821)"
                }
            },
            "type": "object"
        }
    }
}
