{
    "swagger": "2.0",
    "basePath": "/api",
    "paths": {
        "/downloads/v1/sites/{site_id}/missions/{mission_id}/available_downloads": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the mission",
                    "name": "mission_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "502": {
                        "description": "Download service unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "400": {
                        "description": "Mission does not belong to the site, or is older than the availability window",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/AvailableDownload"
                            }
                        }
                    }
                },
                "description": "Returns the downloads available for the specified mission, each with its configurable options.",
                "operationId": "get_available_downloads",
                "tags": [
                    "downloads"
                ]
            }
        },
        "/downloads/v1/sites/{site_id}/missions/{mission_id}/jobs": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the mission",
                    "name": "mission_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "502": {
                        "description": "Download service unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "400": {
                        "description": "Mission does not belong to the site, or is older than the availability window",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/DownloadJob"
                            }
                        }
                    }
                },
                "description": "Lists the download jobs for the specified mission, refreshing their status from the download service.",
                "operationId": "get_download_jobs_list",
                "tags": [
                    "downloads"
                ]
            },
            "post": {
                "responses": {
                    "502": {
                        "description": "Download service unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/DownloadJob"
                        }
                    }
                },
                "description": "Requests (creates) a new download job for the specified mission. download_type must match the 'name' of an available download.",
                "operationId": "post_download_jobs_list",
                "parameters": [
                    {
                        "name": "payload",
                        "required": true,
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/CreateDownloadRequest"
                        }
                    }
                ],
                "tags": [
                    "downloads"
                ]
            }
        },
        "/downloads/v1/sites/{site_id}/missions/{mission_id}/jobs/{download_job_id}": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the download job",
                    "name": "download_job_id",
                    "required": true,
                    "type": "string"
                },
                {
                    "in": "path",
                    "description": "ID of the mission",
                    "name": "mission_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "502": {
                        "description": "Download service unavailable",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "404": {
                        "description": "Download job not found for this mission",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "400": {
                        "description": "Mission does not belong to the site, or is older than the availability window",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/DownloadJob"
                        }
                    }
                },
                "description": "Returns the status of a single download job, polling the download service if the job is not yet in a terminal state.",
                "operationId": "get_download_job_status",
                "tags": [
                    "downloads"
                ]
            }
        },
        "/known-surfaces/v1/sites/{site_id}/known-surfaces": {
            "parameters": [
                {
                    "in": "path",
