        },
        "/known-surfaces/v1/sites/{site_id}/known-surfaces/{known_surface_id}": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the known surface",
                    "name": "known_surface_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "404": {
                        "description": "Known surface not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/KnownSurface"
                        }
                    }
                },
                "description": "Returns a single known surface by ID. The known surface must be active on the specified site.",
                "operationId": "get_known_surface_detail",
                "tags": [
                    "known-surfaces"
                ]
            }
        },
        "/missions/v1/sites": {
            "get": {
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Site"
                            }
                        }
                    }
                },
                "description": "Returns all Sites",
                "operationId": "get_sites",
                "tags": [
                    "v1"
                ]
            }
        },
        "/missions/v1/sites/{site_id}/missions": {
            "parameters": [
                {
                    "description": "ID of the site",
                    "in": "path",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "401": {
                        "description": "Not authorized to access this site",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Mission"
                            }
                        }
                    }
                },
                "description": "Returns all missions for the specified site that are less than 90 days old.",
                "operationId": "get_missions",
                "tags": [
                    "v1"
                ]
            }
        },
        "/missions/v1/sites/{site_id}/missions/latest": {
            "parameters": [
                {
                    "description": "ID of the site",
                    "in": "path",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "401": {
                        "description": "Not authorized to access this site",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/Mission"
                        }
                    }
                },
                "description": "Returns the latest mission for the specified site (if there are any that are less than 90 days old).",
                "operationId": "get_missions_latest_for_site",
                "tags": [
                    "v1"
                ]
            }
        },
        "/missions/v1/sites/{site_id}/missions/{mission_id}/markers": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the mission",
                    "name": "mission_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "400": {
                        "description": "Mission does not belong to the specified site",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Marker"
                            }
                        }
                    }
                },
                "description": "Returns all markers for the specified mission",
                "operationId": "get_markers",
                "tags": [
                    "v1"
                ]
            }
        },
        "/missions/v1/sites/{site_id}/missions/{mission_id}/volumes": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the mission",
                    "name": "mission_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "400": {
                        "description": "Mission does not belong to the specified site",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/MarkerVolume"
                            }
                        }
                    }
                },
                "description": "Returns all volumes for the specified mission. Note that markers of type model volume (marker_type=2) may return two records if multiple surfaces are specified. This data should match the data retrieved from the CSV download from the Volume Report.",
                "operationId": "get_marker_volumes",
                "tags": [
                    "v1"
                ]
            }
        },
        "/products/v1/sites/{site_id}/products": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/Product"
                            }
                        }
                    }
                },
                "description": "Returns all products for the specified site.",
                "operationId": "get_product_list",
                "tags": [
                    "products"
                ]
            }
        },
        "/products/v1/sites/{site_id}/products/{product_id}": {
            "parameters": [
                {
                    "in": "path",
                    "description": "ID of the product",
                    "name": "product_id",
                    "required": true,
                    "type": "integer"
                },
                {
                    "in": "path",
                    "description": "ID of the site",
                    "name": "site_id",
                    "required": true,
                    "type": "integer"
                }
            ],
            "get": {
                "responses": {
                    "404": {
                        "description": "Product not found",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/Error"
                        }
                    },
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/Product"
                        }
                    }
                },
                "description": "Returns a single product by ID. The product must belong to the specified site.",
                "operationId": "get_product_detail",
                "tags": [
                    "products"
                ]
            }
        }
    },
    "info": {
        "title": "Firmatek Missions API",
        "version": "1.0",
        "description": "Public API for accessing Sites, Missions, Markers, Volumes, Products, Known Surfaces, and Downloads in the Kespry Platform. Requests require a Bearer token obtained from the Authentication API (POST /api/auth/, see /api/auth/v1).",
        "termsOfService": "https://firmatek.com/terms-of-use/"
    },
    "produces": [
        "application/json"
    ],
    "consumes": [
        "application/json"
    ],
    "securityDefinitions": {
        "apikey": {
            "type": "apiKey",
            "in": "header",
            "name": "Authorization",
            "description": "JWT obtained from the Authentication API (POST /api/auth/). Provide it with the Bearer prefix, i.e. the header value must be: Bearer <token>"
        }
    },
    "security": [
        {
            "apikey": []
        }
    ],
    "tags": [
        {
            "name": "v1",
            "description": "APIs for accessing Kespry Missions. Missions are captured for each Site. Each mission may have multiple markers that represent different ways to analyze the mission data. Volume marker types report volume values."
        },
        {
            "name": "downloads",
            "description": "APIs for discovering, requesting, and retrieving downloadable analytic products (orthomosaics, DSMs, contours, point clouds, etc.) for a mission. Download files are prepared asynchronously; request a job, poll its status, then fetch the file via the returned presigned URL."
        },
        {
            "name": "products",
            "description": "APIs for accessing Products defined for a Site. Products carry specification values and are referenced by inventory volume markers via product_id."
        },
        {
            "name": "known-surfaces",
            "description": "APIs for accessing Known Surfaces defined for a Site. Known surfaces are reusable base surfaces referenced by volume markers via known_surface_id."
        }
    ],
    "definitions": {
        "Error": {
            "required": [
                "message"
            ],
            "properties": {
                "message": {
                    "type": "string",
                    "description": "Human-readable error message",
                    "example": "Not authorized to access this site (4821)"
                }
            },
            "type": "object"
        },
        "Site": {
            "required": [
                "customer_id",
                "id",
                "name"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Site ID",
                    "example": 4821
                },
                "name": {
                    "type": "string",
                    "description": "Site name",
                    "example": "North Quarry"
                },
                "customer_id": {
                    "type": "integer",
                    "description": "Customer ID",
                    "example": 312
                },
                "center_lat": {
                    "type": "number",
                    "description": "Center latitude in WGS84",
                    "example": 37.7749
                },
                "center_lng": {
                    "type": "number",
                    "description": "Center longitude in WGS84",
                    "example": -122.4194
                },
                "outline": {
                    "type": "object",
                    "description": "Site outline as a GeoJSON geometry (Polygon) in WGS84, e.g. {\"type\": \"Polygon\", \"coordinates\": [[[lng, lat], ...]]}"
                },
                "created_at": {
                    "type": "string",
                    "description": "Date the site was created (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-15 14:30:00"
                },
                "updated_at": {
                    "type": "string",
                    "description": "Date the site was updated (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-20 09:05:12"
                },
                "foreign_key": {
                    "type": "string",
                    "description": "Foreign key for the site (for referencing within the customer environment)",
                    "example": "CUST-SITE-001"
                }
            },
            "type": "object"
        },
        "Mission": {
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Mission ID",
                    "example": 99182
                },
                "uid": {
                    "type": "string",
                    "description": "Internal image ID used by support",
                    "example": "1029384"
                },
                "captured_at": {
                    "type": "string",
                    "description": "Date the mission was captured (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-15 14:30:00"
                },
                "created_at": {
                    "type": "string",
                    "description": "Date the mission was created (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-15 16:02:41"
                },
                "updated_at": {
                    "type": "string",
                    "description": "Date the mission was updated (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-16 08:14:09"
                },
                "status": {
                    "type": "string",
                    "description": "Mission status. Values are pending, pending_gps_update, waiting_for_gps_data, complete, preprocessing, waiting_for_upload, processing_error, or manual_processing",
                    "example": "complete"
                },
                "outline": {
                    "type": "object",
                    "description": "Mission outline as a GeoJSON geometry (Polygon) in WGS84, e.g. {\"type\": \"Polygon\", \"coordinates\": [[[lng, lat], ...]]}"
                },
                "mission_outline": {
                    "type": "object",
                    "description": "Flight/mission boundary as a GeoJSON geometry (Polygon) in WGS84"
                },
                "operator": {
                    "type": "string",
                    "description": "Name of the flight operator",
                    "example": "Jane Doe"
                }
            },
            "type": "object"
        },
        "Marker": {
            "required": [
                "id",
                "image_id"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Marker ID",
                    "example": 550231
                },
                "image_id": {
                    "type": "integer",
                    "description": "Mission ID",
                    "example": 99182
                },
                "name": {
                    "type": "string",
                    "description": "Marker name",
                    "example": "Stockpile 01"
                },
                "description": {
                    "type": "string",
                    "description": "Marker description",
                    "example": "Crushed aggregate"
                },
                "marker_type": {
                    "type": "integer",
                    "description": "Marker type,  0: point, 1: cross section, 2: model volume, 3: volume, 4: inventory volume, 5: area, 6: compliance line, 7: markup, 8: external (Firmatek Services)",
                    "example": 3
                },
                "shape_type": {
                    "type": "string",
                    "description": "Marker geometry type: Point, LineString or Polygon",
                    "example": "Polygon"
                },
                "pile_id": {
                    "type": "integer",
                    "description": "Pile ID",
                    "example": 1
                },
                "known_surface_id": {
                    "type": "integer",
                    "description": "ID of the known surface if the volume_mode is \"known_surface\"",
                    "example": 42
                },
                "density": {
                    "type": "number",
                    "description": "Density (kg/m3)",
                    "example": 1500.0
                },
                "offset": {
                    "type": "number",
                    "description": "Volume offset",
                    "example": 0.0
                },
                "fixed_elevation": {
                    "type": "number",
                    "description": "Elevation to use as the base of the pile if the volume_mode is \"fixed_elevation\" (m)",
                    "example": 312.5
                },
                "geojson": {
                    "type": "object",
                    "description": "Geometry of the marker as a GeoJSON geometry in WGS84, e.g. {\"type\": \"Polygon\", \"coordinates\": [[[lng, lat], ...]]}"
                },
                "created_at": {
                    "type": "string",
                    "description": "Date the marker was created (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-15 16:10:00"
                },
                "updated_at": {
                    "type": "string",
                    "description": "Date the marker was updated (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-16 08:20:00"
                },
                "created_by": {
                    "type": "string",
                    "description": "User who created the marker",
                    "example": "jane.doe@example.com"
                },
                "updated_by": {
                    "type": "string",
                    "description": "User who last updated the marker",
                    "example": "jane.doe@example.com"
                },
                "locked": {
                    "type": "boolean",
                    "description": "Is the marker locked",
                    "example": false
                },
                "is_manual": {
                    "type": "boolean",
                    "description": "Is the marker manual or assigned to an inventory product",
                    "example": false
                },
                "use_extracted": {
                    "type": "boolean",
                    "description": "When true, reported volumes use the feature extracted DSM data",
                    "example": false
                },
                "product_id": {
                    "type": "integer",
                    "description": "ID of the product used if is_manual is False",
                    "example": 781
                },
                "volume_mode": {
                    "type": "string",
                    "description": "Volume mode for the marker if it is a volume based marker. Values are base_points, fixed_elevation, known_surface or none",
                    "example": "base_points"
                },
                "base_points": {
                    "type": "object",
                    "description": "Base points used to define the base of the pile if volume_mode is \"base_points\". Array of [lng, lat, elevation] coordinates in WGS84."
                },
                "messages": {
                    "type": "array",
                    "description": "Processing messages. If present is an array of objects of the form { \"code\": \"small_base_points_area\", \"level\": \"warn\", \"message\": \"Your base points only cover a small area. For accurate measurement add more points over a larger area if possible.\"}",
                    "items": {
                        "type": "object"
                    }
                },
                "comparison_surfaces": {
                    "type": "array",
                    "description": "Comparison surfaces for model volume markers (marker_type=2). Null or absent for all other marker types.",
                    "items": {
                        "$ref": "#/definitions/ComparisonSurface"
                    }
                }
            },
            "type": "object"
        },
        "ComparisonSurface": {
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Comparison surface record ID",
                    "example": 1234
                },
                "comparison_surface_id": {
                    "type": "integer",
                    "description": "ID of the referenced surface (known surface or image)",
                    "example": 42
                },
                "comparison_surface_type": {
                    "type": "string",
                    "description": "Surface type: BasePoints, Image, FixedElevation, or KnownSurface",
                    "example": "KnownSurface"
                },
                "name": {
                    "type": "string",
                    "description": "Display name of the comparison surface",
                    "example": "Base Grade"
                },
                "elevation": {
                    "type": "string",
                    "description": "Fixed elevation value when comparison_surface_type is FixedElevation",
                    "example": "312.5"
                },
                "geojson": {
                    "type": "object",
                    "description": "Geometry of the comparison surface as a GeoJSON object in WGS84"
                }
            },
            "type": "object"
        },
        "MarkerVolume": {
            "required": [
                "name",
                "num"
            ],
            "properties": {
                "num": {
                    "type": "string",
                    "description": "Pile #"
                },
                "name": {
                    "type": "string",
                    "description": "Name"
                },
                "description": {
                    "type": "string",
                    "description": "Description"
                },
                "surface_desc": {
                    "type": "string",
                    "description": "Surface Description"
                },
                "sku": {
                    "type": "string",
                    "description": "SKU Number",
                    "example": "123456"
                },
                "surfaceArea": {
                    "type": "number",
                    "description": "Area (m2)",
                    "example": 411.09
                },
                "perimeter": {
                    "type": "number",
                    "description": "Perimeter (m)",
                    "example": 91.23
                },
                "cutVolume": {
                    "type": "number",
                    "description": "Cut Volume (m3)",
                    "example": 608.44
                },
                "fillVolume": {
                    "type": "number",
                    "description": "Fill Volume (m3)",
                    "example": 3.84
                },
                "threshold": {
                    "type": "number",
                    "description": "Minimum Threshold"
                },
                "offset": {
                    "type": "number",
                    "description": "Offset (m3)"
                },
                "density": {
                    "type": "number",
                    "description": "Density (kg/m3)",
                    "example": 1500.0
                },
                "cutMass": {
                    "type": "number",
                    "description": "Cut Mass (kg)",
                    "example": 912657.94
                },
                "fillMass": {
                    "type": "number",
                    "description": "Fill Mass (kg)",
                    "example": 5757.52
                },
                "usesExtracted": {
                    "type": "boolean",
                    "description": "Indicates if the volume values were calculated using the feature extracted DSM"
                }
            },
            "type": "object"
        },
        "AvailableDownload": {
            "required": [
                "name"
            ],
            "properties": {
                "filename": {
                    "type": "string",
                    "description": "Base output filename",
                    "example": "Orthomosaic"
                },
                "label": {
                    "type": "string",
                    "description": "Human-readable label",
                    "example": "Orthomosaic"
                },
                "name": {
                    "type": "string",
                    "description": "Download type identifier; supply this as download_type when creating a job",
                    "example": "ORTHO"
                },
                "note": {
                    "type": "string",
                    "description": "Advisory note about this download, if any"
                },
                "params": {
                    "type": "array",
                    "description": "Available options for this download",
                    "items": {
                        "$ref": "#/definitions/DownloadParam"
                    }
                }
            },
            "type": "object"
        },
        "DownloadParam": {
            "required": [
                "name"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "description": "Human-readable label",
                    "example": "File Type"
                },
                "name": {
                    "type": "string",
                    "description": "Option key to supply in download_options",
                    "example": "file_type"
                },
                "param_type": {
                    "type": "string",
                    "description": "One of: select, range, bool",
                    "example": "select"
                },
                "required": {
                    "type": "boolean",
                    "description": "Whether the option must be supplied",
                    "example": true
                },
                "values": {
                    "type": "object",
                    "description": "Allowed values for a select, [min, max] for a range, or [true, false] for a bool"
                }
            },
            "type": "object"
        },
        "CreateDownloadRequest": {
            "required": [
                "download_type"
            ],
            "properties": {
                "download_type": {
                    "type": "string",
                    "description": "Must match the 'name' of an available download for this mission",
                    "example": "ORTHO"
                },
                "download_options": {
                    "type": "object",
                    "description": "Option values keyed by param name, e.g. {\"file_type\": \"png\"}"
                }
            },
            "type": "object"
        },
        "DownloadJob": {
            "required": [
                "job_id"
            ],
            "properties": {
                "job_id": {
                    "type": "string",
                    "description": "Download job ID; use it to poll status",
                    "example": "a8937cd4-4070-4b8e-8235-7dbd98886e3c"
                },
                "created_at": {
                    "type": "string",
                    "description": "Job creation time (UTC, ISO-8601, e.g. 2026-06-10T17:01:30Z)",
                    "example": "2026-06-10T17:01:30Z"
                },
                "status": {
                    "type": "string",
                    "description": "Job status: NEW, PENDING, QUEUED, STARTED, RUNNING, SCHEDULED, SUCCESS, FAILED, or STOPPED",
                    "example": "SUCCESS"
                },
                "name": {
                    "type": "string",
                    "description": "Download type",
                    "example": "ORTHO"
                },
                "options": {
                    "type": "object",
                    "description": "Options the job was created with"
                },
                "presigned_url": {
                    "type": "string",
                    "description": "Time-limited (15-minute) S3 URL to download the output file; null until the job succeeds"
                },
                "file_status": {
                    "type": "string",
                    "description": "'exists' when the output file is present, 'missing' if it is gone/expired, 'unknown' before the job produces output",
                    "example": "exists"
                }
            },
            "type": "object"
        },
        "Product": {
            "required": [
                "id",
                "name",
                "site_id"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Product ID",
                    "example": 781
                },
                "name": {
                    "type": "string",
                    "description": "Product name",
                    "example": "Crushed Limestone"
                },
                "site_id": {
                    "type": "integer",
                    "description": "ID of the site this product belongs to",
                    "example": 4821
                },
                "values": {
                    "type": "object",
                    "description": "Product specification values as a JSON array"
                }
            },
            "type": "object"
        },
        "KnownSurface": {
            "required": [
                "id",
                "surface_name"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "description": "Known surface ID",
                    "example": 42
                },
                "surface_name": {
                    "type": "string",
                    "description": "Name of the known surface",
                    "example": "Base Grade"
                },
                "surface_description": {
                    "type": "string",
                    "description": "Description of the known surface",
                    "example": "Pre-construction base grade survey"
                },
                "review_status": {
                    "type": "string",
                    "description": "Review status of the surface model",
                    "example": "approved"
                },
                "surface_image_file_name": {
                    "type": "string",
                    "description": "File name of the surface image attachment",
                    "example": "base_grade.png"
                },
                "surface_image_content_type": {
                    "type": "string",
                    "description": "MIME type of the surface image attachment",
                    "example": "image/png"
                },
                "created_at": {
                    "type": "string",
                    "description": "Date the known surface was created (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-01-10 09:00:00"
                },
                "updated_at": {
                    "type": "string",
                    "description": "Date the known surface was last updated (UTC, format 'YYYY-MM-DD HH:MM:SS')",
                    "example": "2024-03-05 14:22:11"
                }
            },
            "type": "object"
        }
    },
    "responses": {
        "ParseError": {
            "description": "When a mask can't be parsed"
        },
        "MaskError": {
            "description": "When any error occurs on mask"
        }
    }
}
